!include main.styles.puml

!procedure $mereology($outer, $size, $half, $inner, $ox, $oy, $ix, $iy)
skinparam Rectangle {
  BackgroundColor transparent
  BorderColor transparent
}
sprite mereology <svg viewBox="0 0 $size $size">
<circle cx="$size" cy="$size" r="$size" fill="#FEFECE" stroke="#A80036" stroke-width="2"/>
<circle cx="$size" cy="$size" r="$half" fill="#FFFFFF" stroke="#A80036" stroke-width="2"/>
<text x="$ox" y="$oy" text-anchor="middle" dominant-baseline="middle" fill="#000000" font-size="14" font-weight="700">$outer</text>
<text x="$ix" y="$iy" text-anchor="middle" dominant-baseline="middle" fill="#000000" font-size="14" font-weight="700">$inner</text>
</svg>
rectangle "<$mereology>"
!endprocedure
