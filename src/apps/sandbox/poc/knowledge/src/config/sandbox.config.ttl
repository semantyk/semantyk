#––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

PREFIX :          <urn:semantyk:system:>
PREFIX fuseki:    <http://jena.apache.org/fuseki#>
PREFIX geosparql: <http://jena.apache.org/geosparql#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:      <http://jena.apache.org/2016/tdb#>

:sandbox_store  rdf:type  tdb2:DatasetTDB2 ;
        tdb2:location  "/fuseki/databases/sandbox" .

:sandbox  rdf:type  geosparql:geosparqlDataset ;
        geosparql:dataset           :sandbox_store ;
        geosparql:spatialIndexFile  "/fuseki/databases/sandbox/spatial.index" ;
        geosparql:srsUri            <http://www.opengis.net/def/crs/OGC/1.3/CRS84> ;
        geosparql:inference         true ;
        geosparql:queryRewrite      true ;
        geosparql:indexEnabled      true .

:sandbox_service  rdf:type  fuseki:Service ;
        fuseki:name     "sandbox" ;
        fuseki:dataset  :sandbox ;
        fuseki:endpoint [ fuseki:operation fuseki:query ] ;
        fuseki:endpoint [ fuseki:operation fuseki:update ] ;
        fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ] ;
        fuseki:endpoint [ fuseki:name "sparql" ; fuseki:operation fuseki:query ] ;
        fuseki:endpoint [ fuseki:name "update" ; fuseki:operation fuseki:update ] ;
        fuseki:endpoint [ fuseki:name "data"   ; fuseki:operation fuseki:gsp-rw ] ;
        fuseki:endpoint [ fuseki:name "get"    ; fuseki:operation fuseki:gsp-r ] ;
        fuseki:endpoint [ fuseki:name "upload" ; fuseki:operation fuseki:upload ] ;
        fuseki:endpoint [ fuseki:name "shacl"  ; fuseki:operation fuseki:shacl ] .
