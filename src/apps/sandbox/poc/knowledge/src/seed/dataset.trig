#––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
# `dataset.trig`
# @organization: Semantyk
# @project: Ecosystem
#
# @file: This file defines the TriG seed for each Fuseki logical dataset.
#
# @created: 2026-09-02 13:58
# @modified: 2026-09-02 14:32
#
# @since: 0.1.0-alpha.47
# @version: 0.1.0-alpha.50
#
# @author: Semantyk Team
# @maintainer: Daniel Bakas <daniel@semantyk.com>
#
# @copyright: Semantyk © 2026
#––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
#
# Placeholders: SEMANTYK_NS, DATASET (Fuseki service name = logical graph name).
# Rules:
# - Logical graph = default graph (sd:Dataset / sd:GraphCollection).
# - Named graphs = partitions only: {tbox, abox, vbox}.
# - Never keep a named graph at the logical IRI itself.

@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .

{
  <${SEMANTYK_NS}/${DATASET}> a sd:Dataset , sd:GraphCollection ;
    sd:namedGraph
      <${SEMANTYK_NS}/${DATASET}/tbox> ,
      <${SEMANTYK_NS}/${DATASET}/abox> ,
      <${SEMANTYK_NS}/${DATASET}/vbox> .
}

GRAPH <${SEMANTYK_NS}/${DATASET}/tbox> {
  <${SEMANTYK_NS}/${DATASET}/tbox> a sd:NamedGraph ;
    sd:name <${SEMANTYK_NS}/${DATASET}/tbox> .
}

GRAPH <${SEMANTYK_NS}/${DATASET}/abox> {
  <${SEMANTYK_NS}/${DATASET}/abox> a sd:NamedGraph ;
    sd:name <${SEMANTYK_NS}/${DATASET}/abox> .
}

GRAPH <${SEMANTYK_NS}/${DATASET}/vbox> {
  <${SEMANTYK_NS}/${DATASET}/vbox> a sd:NamedGraph ;
    sd:name <${SEMANTYK_NS}/${DATASET}/vbox> .
}
