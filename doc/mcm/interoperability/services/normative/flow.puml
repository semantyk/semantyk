@startuml "FLUJO DE SERVICIOS NORMATIVOS"

'* Imports
!include ../../../../../src/packages/ux/styles/main.styles.puml

'* Main
mainframe <<servicios>>\n**NORMATIVOS**

start

split
    :NORMAS VINCULANTES;
    split
    :ATRIBUCIONES;
    split again
    :DERECHOS;
    split again
    :OBLIGACIONES;
    end split
split again
    :NORMAS NO VINCULANTES;
    split
        :BASE CONCEPTUAL;
    split again
        :BASE METODOLÓGICA;
    end split
end split
:DOCUMENTACIÓN;
:ACUERDOS;

stop

footer <size:8>Semantyk © 2026</size>

@enduml
