@startuml "FLUJO DE SERVICIOS SEMÁNTICOS"

start

split
    :TÉRMINOS;
split again
    :DEFINICIONES;
split again
    :RELACIONES;
split again
    :REGLAS;
end split

partition "REPRESENTACIONES DE CONOCIMIENTO" {
    :GLOSARIOS;
    :VOCABULARIOS;
    split
        :MEREOLOGÍAS;
    split again
        :TAXONOMÍAS;
    split again
        :JERARQUÍAS;
    split again
        :TESAUROS;
    end split
    partition "ONTOLOGÍAS" {
        split
            :CAJAS TERMINOLÓGICAS;
        split again
            :CAJAS ASERCIONALES;
        end split
    }
}

:DOCUMENTACIÓN;
:ACUERDOS;

stop

mainframe <<servicios>>\n**SEMÁNTICOS**

footer <size:8>Semantyk © 2026</size>

@enduml
