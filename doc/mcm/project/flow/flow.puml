@startuml "FLUJO DE PROYECTO"

'* Imports
!include ../../../../src/packages/ux/styles/main.styles.puml

'* Main
mainframe <<flujo>>\n**PROYECTO**

start
:ARRANQUE;
:PLANEACIÓN;
:ANÁLISIS;
:DISEÑO;
:IMPLEMENTACIÓN;
:PRUEBAS;
:LANZAMIENTO;
partition "SEGUIMIENTO" {
    split
    :EVALUACIÓN;
    split again
    :MANTENIMIENTO;
    split again
    :MEJORA;
    split again
    :MONITOREO;
    end split
}
stop

footer <size:8>Semantyk © 2026</size>

@enduml

