@startuml "FLUJO DE SERVICIOS DE GOBERNANZA"

'* Imports
!include ../../../../src/packages/ux/styles/main.styles.puml

'* Main
mainframe <<flujo>>\n**GOBERNANZA DIGITAL**

start

partition "ECOSISTEMA" {
    partition "INVENTARIOS, SERVICIOS Y PRODUCTOS" {
        split
            :NORMATIVOS;
        split again
            :ORGANIZATIVOS;
        split again
            :SEMÁNTICOS;
        split again
            :TECNOLÓGICOS;
        end split
        partition "RECURSOS REUTILIZABLES" {
            :COMPONENTES;
            :MÓDULOS;
        }
        split
            partition "EXTERNOS" {
                :INFRAESTRUCTURAS;
                :PRODUCTOS;
            }
        split again
            partition "INTERNOS" {
                :INFRAESTRUCTURAS;
                :PRODUCTOS;
            }
        end split
    }
    partition "PLATAFORMA" {
        :INFRAESTRUCTURA;
        :PRODUCTOS;
    }
}
:DOCUMENTACIÓN;
:ACUERDOS;

stop

footer <size:8>Semantyk © 2026</size>

@enduml
